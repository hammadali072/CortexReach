{
  "rules": {
    ".read":  "auth != null",
    ".write": "auth != null",

    "users": {
      "$uid": {
        ".read":  "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    "projects": {
      ".indexOn": ["userId"],
      "$projectId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "leads": {
      ".indexOn": ["projectId", "email", "userId"],
      "$leadId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "campaigns": {
      ".indexOn": ["projectId", "userId"],
      "$campaignId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "email_sends": {
      ".indexOn": ["campaignId", "leadId", "projectId", "resendEmailId", "type"],
      "$sendId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "follow_ups": {
      ".indexOn": ["campaignId", "userId"],
      "$followUpId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    }
  }
}